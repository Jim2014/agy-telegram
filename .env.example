# Telegram Bot Token from @BotFather (e.g. 123456789:ABCdefGHIjklMNOpqrsTUVwxyz)
BOT_TOKEN=your_bot_token_here

# Allowed Telegram Chat IDs (comma-separated). Leave empty to allow any chat.
# Example: ALLOWED_CHAT_IDS=123456789,987654321
ALLOWED_CHAT_IDS=

# agy CLI binary path (defaults to /Users/jim/.local/bin/agy or agy in PATH)
AGY_BIN_PATH=/Users/jim/.local/bin/agy

# Working directory for agy workspace (--add-dir). Defaults to current working directory.
AGY_WORKING_DIR=

# Default agy model (leave empty for agy default)
DEFAULT_MODEL=

# Default reasoning effort (low, medium, high)
DEFAULT_EFFORT=medium

# Streaming rate limit / throttle in seconds for Telegram editMessageText (default: 1.0)
STREAM_THROTTLE_SECONDS=1.0

# Timeout for agy subprocess in seconds (default: 300)
AGY_TIMEOUT_SECONDS=300

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
